<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<connectionStrings>
		<add name="MyDbConn"
			 connectionString="Server=MRYOSO-DESKTOP\SQLEXPRESS;Database=PersonalWebsiteDB;Trusted_Connection=True;"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

	<appSettings>
		<!-- Palitan ang mga value na ito ng iyong sariling Gmail address at 16-character App Password -->
		<add key="SenderEmail" value="esteban.jamesbenedict.mabbayad.12@gmail.com" />
		<add key="SenderAppPassword" value="rnrf lmqh ylhe damy" />
	</appSettings>

	<system.web>
		<compilation debug="true" targetFramework="4.8" />
		<httpRuntime targetFramework="4.8" />

		<authentication mode="Forms">
			<forms loginUrl="Account/Login.aspx" timeout="2880" />
		</authentication>

		<customErrors mode="Off" />
	</system.web>

	<system.webServer>
		<defaultDocument>
			<files>
				<clear />
				<add value="Default.aspx" />
			</files>
		</defaultDocument>
	</system.webServer>

</configuration>